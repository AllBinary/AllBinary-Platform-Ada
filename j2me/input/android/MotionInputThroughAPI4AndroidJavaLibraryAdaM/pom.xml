<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.allbinary</groupId>
    <artifactId>MotionInputThroughAPI4AndroidJavaLibraryAda</artifactId>
    <packaging>jar</packaging>
    <!-- AllBinary Platform Version Start -->            
    <version>1.0.0-SNAPSHOT</version>
    <!-- AllBinary Platform Version End -->
    <name>MotionInputThroughAPI4AndroidJavaLibraryAda</name>
    <url>http://maven.apache.org</url>

    <distributionManagement>
        <snapshotRepository>
            <id>nexus-snapshots</id>
            <name>AllBinary Snapshots Nexus</name>
            <url>https://nexus-allbinary.rhcloud.com/nexus/content/repositories/snapshots/</url>
        </snapshotRepository>
        <repository>
            <id>nexus-releases</id>
            <name>AllBinary Releases Nexus</name>
            <url>https://nexus-allbinary.rhcloud.com/nexus/content/repositories/releases/</url>
        </repository>
    </distributionManagement>
    


    <properties>
        <cygwin.home>G:/cygwin64</cygwin.home>
        <ada.runtime.source.path>G:/mnt/bc/mydev/workada/j2me/J2SEForAdaLibraryAdaM/src/main/java</ada.runtime.source.path>
        <ada.jsinterop.source.path>G:/mnt/bc/mydev/workingada/replace_these_stub_projects/allbinary_src/J2MEJsInteropCompatibilityJavaLibraryAdaM/src/main/java</ada.jsinterop.source.path>
        <ada.standard>-gnat2022</ada.standard>
        <ada.compiler.flags>-O2 -gnatwa -gnatf</ada.compiler.flags>
        <ada.fail.on.error>true</ada.fail.on.error>
    </properties>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>3.8.1</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.allbinary</groupId>
            <artifactId>LoggingJ2MEAllAda</artifactId>
            <!-- AllBinary Platform Version Start -->            
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.allbinary</groupId>
            <artifactId>LogJ2MEJavaLibraryAda</artifactId>
            <!-- AllBinary Platform Version Start -->
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->

            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.allbinary</groupId>
            <artifactId>MotionInputAndroidJavaLibraryAda</artifactId>
            <!-- AllBinary Platform Version Start -->            
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->
        </dependency>

        <dependency>
            <groupId>com.google.android</groupId>
            <artifactId>androidAda</artifactId>
            <version>1.5_r3</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.android</groupId>
            <artifactId>androidAda</artifactId>
            <version>1.5_r3</version>
            <scope>provided</scope>
            <classifier>sources</classifier>
        </dependency>
    </dependencies>



    <build>
        
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>compile-cygwin-ada-sources</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${cygwin.home}/bin/bash.exe</executable>
                            <arguments>
                                <argument>${project.basedir}/build-cygwin.sh</argument>
                                <argument>${project.basedir}/src/main/java</argument>
                                <argument>${project.build.directory}/ada</argument>
                                <argument>${project.build.outputDirectory}/META-INF/native</argument>
                                <argument>${project.build.outputDirectory}/META-INF/ada</argument>
                                <argument>${project.artifactId}</argument>
                                <argument>${ada.standard}</argument>
                                <argument>${ada.compiler.flags}</argument>
                                <argument>${ada.fail.on.error}</argument>
                                <argument>${ada.runtime.source.path}</argument>
                                <argument>${ada.jsinterop.source.path}</argument>
                                <argument>${project.build.directory}/ada-dependencies/META-INF/ada</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>unpack-ada-dependencies</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>unpack-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeGroupIds>org.allbinary</includeGroupIds>
                            <includes>META-INF/ada/**</includes>
                            <outputDirectory>${project.build.directory}/ada-dependencies</outputDirectory>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>


            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>

    </build>

</project>

